+    program = r'''
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef float Real;
+struct GameClientCameraLocks { bool m_lockC0; } client = { false };
+void *TheGameClient = &client;
+struct Limits {
