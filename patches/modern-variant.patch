+#ifndef BFME2_MODERN_CAMERA_INTERPOLATION_H
+#define BFME2_MODERN_CAMERA_INTERPOLATION_H
+#if !defined(BFME2_MODERN)
+#error Modern camera interpolation requires the modern variant
+#endif
+class CameraClass;
+void modernBeginCameraUpdate();
+void modernResetCamera(const void *view);
+// A load/map setup can capture intermediate poses before it returns or throws.
+// Clear on both boundaries so none become interpolation endpoints.
+class ModernCameraDiscontinuity
+{
+public:
+    explicit ModernCameraDiscontinuity(const void *view) : m_view(view)
+    { modernResetCamera(m_view); }
+    ~ModernCameraDiscontinuity() { modernResetCamera(m_view); }
+private:
+    ModernCameraDiscontinuity(const ModernCameraDiscontinuity &);
+    ModernCameraDiscontinuity &operator=(const ModernCameraDiscontinuity &);
+    const void *m_view;
+};
+// Only borrows the camera for one draw, never across an update or destruction.
+class ModernCameraPresentation
+{
+public:
+    ModernCameraPresentation(const void *view, CameraClass *camera);
+    ~ModernCameraPresentation();
+private:
+    ModernCameraPresentation(const ModernCameraPresentation &);
+    ModernCameraPresentation &operator=(const ModernCameraPresentation &);
+    CameraClass *m_camera;
+    float m_original[12];
+};
+#endif
diff --git a/Code/GameEngine/Include/Common/ModernFrameSchedule.h b/Code/GameEngine/Include/Common/ModernFrameSchedule.h
new file mode 100644
index 00000000000..496df7d4c72
--- /dev/null
+++ b/Code/GameEngine/Include/Common/ModernFrameSchedule.h
@@ -0,0 +1,105 @@
+#ifndef BFME2_MODERN_FRAME_SCHEDULE_H
+#define BFME2_MODERN_FRAME_SCHEDULE_H
+
+#if !defined(BFME2_MODERN)
+#error ModernFrameSchedule belongs only to the explicit modern variant
+#endif
+
+#include <assert.h>
+
+// Counter ticks are supplied by the caller (QueryPerformanceCounter in game).
+// Keep the original client update frequency independent of presentation rate.
+// The caller may limit catch-up work per presentation, but debt is never lost.
+class ModernFrameSchedule
+{
+public:
+    ModernFrameSchedule(__int64 frequency, int updateRate, int renderRate)
+        : m_frequency(frequency), m_updateRate(updateRate), m_renderRate(renderRate)
+    {
+        assert(frequency > 0 && updateRate > 0 && renderRate >= 0);
+        reset(0);
+    }
+
+    // Call on startup and on pause/resume or load transitions. Time spent
+    // paused must not turn into a burst of game updates when resuming.
+    void reset(__int64 now)
+    {
+        m_previous = now;
+        m_updateCredit = 0;
+        m_renderPhase = 0;
+        m_renderReady = true;
+        m_visualStart = now;
+        m_visualPeriod = 0;
+    }
+
+    void advance(__int64 now)
+    {
+        if (now < m_previous)
+        {
+            reset(now);
+            return;
+        }
+        const __int64 elapsed = now - m_previous;
+        m_previous = now;
+        m_updateCredit += elapsed * m_updateRate;
+        if (m_renderRate != 0)
+        {
+            const __int64 credit = m_renderPhase + elapsed * m_renderRate;
+            if (credit >= m_frequency) m_renderReady = true;
+            m_renderPhase = credit % m_frequency;
+        }
+    }
+
+    bool takeUpdate()
+    {
+        if (m_updateCredit < m_frequency) return false;
+        m_updateCredit -= m_frequency;
+        return true;
+    }
+
+    float interpolation() const
+    {
+        // A caller yielding during catch-up must never extrapolate past the
+        // latest complete state. Interpolate previous/current snapshots only.
+        if (m_updateCredit >= m_frequency) return 1.0f;
+        return (float)((double)m_updateCredit / (double)m_frequency);
+    }
+
+    bool renderDue() const { return m_renderRate == 0 || m_renderReady; }
+    // The engine retains its original update pacing; visual time follows that
+    // actual boundary rather than this scheduler's unused update-credit path.
+    void markVisualUpdate(__int64 now, __int64 period)
+    {
+        m_visualStart = now;
+        m_visualPeriod = period > 0 ? period : 1;
+    }
+    float visualInterpolation(__int64 now) const
+    {
+        if (!m_visualPeriod) return 1.0f;
+        if (now <= m_visualStart) return 0.0f;
+        if (now - m_visualStart >= m_visualPeriod) return 1.0f;
+        return (float)((double)(now - m_visualStart) / (double)m_visualPeriod);
+    }
+    void presented() { m_renderReady = false; }
+
+    void setRenderRate(int rate)
+    {
+        assert(rate >= 0);
+        m_renderRate = rate;
+        m_renderPhase = 0;
+        m_renderReady = true;
+    }
+
+private:
+    __int64 m_frequency;
+    __int64 m_previous;
+    __int64 m_updateCredit;
+    __int64 m_renderPhase;
+    __int64 m_visualStart;
+    __int64 m_visualPeriod;
+    int m_updateRate;
+    int m_renderRate;
+    bool m_renderReady;
+};
+
+#endif
diff --git a/Code/GameEngine/Include/Common/ModernRenderPhase.h b/Code/GameEngine/Include/Common/ModernRenderPhase.h
new file mode 100644
index 00000000000..50605fbd375
--- /dev/null
+++ b/Code/GameEngine/Include/Common/ModernRenderPhase.h
@@ -0,0 +1,63 @@
+#ifndef BFME2_MODERN_RENDER_PHASE_H
+#define BFME2_MODERN_RENDER_PHASE_H
+
+#if !defined(BFME2_MODERN)
+#error ModernRenderPhase belongs only to the explicit modern variant
+#endif
+
+// Legacy callers (loading screens and movie playback) retain their combined
+// update/draw pass. The main loop can own fixed updates and presentation apart.
+enum ModernRenderPhase
+{
+    MODERN_RENDER_LEGACY,
+    MODERN_RENDER_UPDATE,
+    MODERN_RENDER_PRESENT
+};
+
+// Loading-screen workers retain their own combined update/draw phase even
+// while the main thread is inside a fixed update or extra presentation.
+extern __declspec(thread) ModernRenderPhase g_modernRenderPhase;
+extern __declspec(thread) float g_modernVisualAlpha;
+void modernPresentFrame();
+// Set after each fixed update; the next Apt draw consumes it. Apt marks its
+// custom-rendered component windows only on a frame after an update, so the
+// per-frame "hide what was not drawn" pass belongs to that frame alone.
+extern bool g_modernAptFreshUpdate;
+// Clears the push-button clocks drawn since the last update (W3DPushButton).
+void modernClearPushButtonClocks();
+// Unit model interpolation (W3DModelDrawDoDrawModule.cpp): prune and advance at
+// each update; apply the blend for a presentation and restore it afterwards.
+void modernBeginModelUpdate();
+void modernApplyModelInterpolation(float alpha);
+void modernRestoreModelInterpolation();
+// The active radial menu (Rva005C6CCC.cpp): registered on update, dropped by
+// its destructor, re-laid out at presentation under the interpolated camera.
+void modernRadialSeen(void *radial);
+void modernRadialGone(void *radial);
+void modernRefreshRadial();
+// Opt-in pacing trace (BFME2_MODERN_TRACE=1): one CSV line per event with a
+// microsecond timestamp, written to modern_trace.csv in the working directory.
+void modernTrace(char kind, double a, double b, double c, double d);
+void modernAdvanceViewEffects();
+void modernAdvanceCrossFade();
+void modernAdvanceBW();
+bool modernAdvanceMotionBlurEndPan();
+
+inline bool modernUpdatesScene() { return g_modernRenderPhase != MODERN_RENDER_PRESENT; }
+inline bool modernPresentsScene() { return g_modernRenderPhase != MODERN_RENDER_UPDATE; }
+
+class ModernRenderScope
+{
+public:
+    explicit ModernRenderScope(ModernRenderPhase phase) : m_previous(g_modernRenderPhase)
+    {
+        g_modernRenderPhase = phase;
+    }
+    ~ModernRenderScope() { g_modernRenderPhase = m_previous; }
+private:
+    ModernRenderScope(const ModernRenderScope &);
+    ModernRenderScope &operator=(const ModernRenderScope &);
+    ModernRenderPhase m_previous;
+};
+
+#endif
diff --git a/Code/GameEngine/Include/Common/ModernVisualHistory.h b/Code/GameEngine/Include/Common/ModernVisualHistory.h
new file mode 100644
index 00000000000..9829ecda2e5
--- /dev/null
+++ b/Code/GameEngine/Include/Common/ModernVisualHistory.h
@@ -0,0 +1,84 @@
+#ifndef BFME2_MODERN_VISUAL_HISTORY_H
+#define BFME2_MODERN_VISUAL_HISTORY_H
+
+#if !defined(BFME2_MODERN)
+#error ModernVisualHistory belongs only to the explicit modern variant
+#endif
+
+// Owned by the visual object's lifetime, never by its address in a global map.
+// The caller supplies a monotonically increasing client-update serial and
+// resets on recreation/load. Teleports explicitly break continuity. Capture
+// the settled pose even on stationary updates, so old movement cannot repeat.
+// Value::Lerp must interpolate the visual value without touching game state.
+template<class Value> class ModernVisualHistory
+{
+public:
+    ModernVisualHistory() : m_valid(false), m_serial(0) {}
+    void reset() { m_valid = false; }
+
+    void capture(const Value &value, unsigned int serial, bool continuous)
+    {
+        if (!m_valid || !continuous ||
+            (serial != m_serial && serial - m_serial != 1))
+        {
+            m_previous = value;
+        }
+        else if (serial != m_serial)
+        {
+            m_previous = m_current;
+        }
+        m_current = value;
+        m_serial = serial;
+        m_valid = true;
+    }
+
+    bool sample(float alpha, Value &out) const
+    {
+        if (!m_valid) return false;
+        // Treat NaN like the latest state, never feed it into matrix math.
+        if (!(alpha < 1.0f)) out = m_current;
+        else if (alpha <= 0.0f) out = m_previous;
+        else Value::Lerp(m_previous, m_current, alpha, out);
+        return true;
+    }
+
+private:
+    Value m_previous;
+    Value m_current;
+    bool m_valid;
+    unsigned int m_serial;
+};
+
+// This scope borrows a live render object; it must not outlive or delete it.
+// Use the object's setter both ways so camera frusta and model hierarchy
+// caches are invalidated after application AND restoration. Do not use this
+// on the simulation object or across a game update. Set_Transform must not throw.
+template<class Target, class Value> class ModernVisualTransformScope
+{
+public:
+    ModernVisualTransformScope(Target &target,
+                               const ModernVisualHistory<Value> &history,
+                               float alpha)
+        : m_target(target), m_active(false)
+    {
+        Value visual;
+        if (history.sample(alpha, visual))
+        {
+            m_original = target.Get_Transform();
+            target.Set_Transform(visual);
+            m_active = true;
+        }
+    }
+    ~ModernVisualTransformScope()
+    {
+        if (m_active) m_target.Set_Transform(m_original);
+    }
+private:
+    ModernVisualTransformScope(const ModernVisualTransformScope &);
+    ModernVisualTransformScope &operator=(const ModernVisualTransformScope &);
+    Target &m_target;
+    Value m_original;
+    bool m_active;
+};
+
+#endif
