+	int kept = 0;
+	for (int i = 0; i < s_modernModelCount; ++i)
+	{
+		ModernModelHistory &entry = s_modernModels[i];
+		if (entry.serial != s_modernVisualSerial)
+		{
+			entry.object->Release_Ref();
